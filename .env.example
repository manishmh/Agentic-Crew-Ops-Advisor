# Node 22.12+ loads .env for npm run api/start/eval:agent commands.
# Keep all provider secrets on the backend. Never use a VITE_ prefix for secrets.
CREWOPS_LLM_PROVIDER=disabled
CREWOPS_LLM_MODEL=openai/gpt-oss-20b
CREWOPS_LLM_API_KEY=
# For Groq, use provider=openai with this compatible Responses API root.
CREWOPS_LLM_BASE_URL=https://api.groq.com/openai/v1
# For OpenAI: base URL https://api.openai.com/v1 and an available model.
# OPENAI_API_KEY is accepted as an alternative backend key.
CREWOPS_LLM_TIMEOUT_MS=12000

# Local defaults. Railway provides PORT automatically and the server binds 0.0.0.0.
CREWOPS_PORT=8080
CREWOPS_HOST=127.0.0.1
# Dataset defaults to ./data.
CREWOPS_RATE_LIMIT=20
CREWOPS_RATE_WINDOW_MS=600000
CREWOPS_MAX_BODY_BYTES=4096
# Same-origin deployment recommended; optional single exact cross-origin origin.
CREWOPS_ALLOWED_ORIGIN=
# ONLY enable behind a proxy that overwrites X-Forwarded-For with ONE client IP
# and blocks direct public access to the backend.
CREWOPS_TRUST_PROXY=false

# Vercel only (set in the frontend project's environment variables, never on Railway):
# VITE_CREWOPS_API_BASE_URL=https://your-railway-service.up.railway.app
