{
  "name": "crew-ops-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "CrewOps Recovery Copilot — deterministic airline crew disruption analysis with an optional LLM planner",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:vercel": "npm run build && npm run build --prefix frontend",
    "start": "node --env-file-if-exists=.env dist/src/api/server.js",
    "api": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:agent": "tsc --declaration false && node --env-file-if-exists=.env dist/evals/runAgentEval.js",
    "eval:agent:live": "tsc --declaration false && node --env-file-if-exists=.env dist/evals/runAgentEval.js --live"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
